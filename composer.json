{
    "name": "estratos/finkok-utils",
    "description": "Bundle de Symfony 7.4 que adapta los Web Services SOAP de utilerías de Finkok (fecha/hora, descarga de XML, reportes de créditos, totales y UUID) sin depender de ext-soap.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "cfdi",
        "sat",
        "finkok",
        "utilerias",
        "utilities",
        "reportes",
        "facturacion",
        "soap"
    ],
    "authors": [
        {
            "name": "Estratos Consulting",
            "email": "julio@estratos.net",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/estratos/finkok-utils",
    "support": {
        "issues": "https://github.com/estratos/finkok-utils/issues",
        "source": "https://github.com/estratos/finkok-utils",
        "docs": "https://github.com/estratos/finkok-utils#readme"
    },
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "estratos/finkok-bundle": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/http-client-contracts": "^3.5",
        "symfony/http-kernel": "^7.4"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^11.5",
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Estratos\\FinkokUtilsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Estratos\\FinkokUtilsBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:live": "phpunit --group live",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 -P4 php -l > /dev/null",
        "security": "composer audit --no-interaction"
    }
}
